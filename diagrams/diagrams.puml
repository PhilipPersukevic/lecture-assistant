@startuml
left to right direction

component "Naudotojo sąsaja" as UI
component "Paskaitų asistento\nbackend" as Backend
component "Failų valdymas" as Files
component "Transkripcijos\nmodulis" as Transcription
component "Whisper API" as Whisper
component "DI analizės\nmodulis" as AI
component "Gemini API" as Gemini
database "Duomenų bazė" as DB

UI --> Backend : HTTP/HTTPS
Backend --> Files : Įrašų saugojimas
Backend --> Transcription : Garso/vaizdo apdorojimas
Transcription --> Whisper : Audio
Whisper --> Transcription : Transkripcija

Backend --> AI : Transkripcijos tekstas
AI --> Gemini : Analizės užklausa
Gemini --> AI : DI rezultatai

Backend --> DB : Išsaugoti duomenis
DB --> Backend : Nuskaityti duomenis

Backend --> UI : Rezultatai

@enduml

@startuml
actor "Studentas" as Studentas
participant "Naudotojo sąsaja" as UI
participant "Backend" as Backend
participant "Whisper API" as Whisper
participant "Gemini API" as Gemini
database "Duomenų bazė" as DB

Studentas -> UI : Įkelia paskaitos įrašą
UI -> Backend : Siunčia įrašą
Backend -> DB : Išsaugo įrašą

Backend -> Whisper : Siunčia garso takelį
Whisper --> Backend : Grąžina transkripciją

Backend -> DB : Išsaugo transkripciją

Backend -> Gemini : Siunčia transkripciją
Gemini --> Backend : Grąžina santrauką
Gemini --> Backend : Grąžina pagrindines sąvokas
Gemini --> Backend : Grąžina savitikros klausimus

Backend -> DB : Išsaugo DI rezultatus
Backend --> UI : Grąžina rezultatus
UI --> Studentas : Parodo transkripciją,\nsantrauką, sąvokas ir klausimus

@enduml
